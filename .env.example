# Yet Another YouTube Downloader (YAYTD)
# Production: run sudo ./scripts/install.sh — it generates every secret randomly.
# Manual dev copy: fill placeholders below or use openssl rand -base64 48

DATABASE_URL="postgresql://yaytd:CHANGE_DB_PASSWORD@127.0.0.1:5432/yaytd?schema=public"

# Generated by install.sh (random, never commit real values)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
DOWNLOAD_TOKEN_SECRET="change-me-another-random-string-at-least-32-chars"

PASSWORD_HASH_ALGORITHM="argon2id"
ARGON2_MEMORY_COST="65536"
ARGON2_TIME_COST="3"
ARGON2_PARALLELISM="4"
BCRYPT_COST="12"

# Public URL (HTTPS at reverse proxy)
APP_URL="https://yaytd.example.com"
AUTH_URL="https://yaytd.example.com"
NEXTAUTH_URL="https://yaytd.example.com"
NEXT_PUBLIC_APP_URL="https://yaytd.example.com"
AUTH_TRUST_HOST="true"

# ALLOWED_ORIGINS="https://www.yaytd.example.com"
# ALLOWED_HOSTS="www.yaytd.example.com"

SESSION_MAX_AGE_SECONDS="604800"
SESSION_UPDATE_AGE_SECONDS="86400"

TRUST_PROXY="true"
TRUSTED_PROXY_HOPS="1"

MAXMIND_LICENSE_KEY=""
MAXMIND_ACCOUNT_ID=""
MAXMIND_GEOLITE_CITY_PATH="data/GeoLite2-City.mmdb"
LOGIN_HISTORY_LIMIT="50"
LOGIN_HISTORY_RETENTION_DAYS="90"

NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
TEMP_DOWNLOAD_DIR="/var/lib/yaytd/downloads"
JOB_TTL_HOURS="2"

MAX_VIDEO_DURATION_SECONDS="7200"
MAX_OUTPUT_BYTES="2147483648"
MAX_CONCURRENT_JOBS_PER_USER="3"
MAX_PENDING_JOBS_PER_USER="10"

REDIS_URL="redis://127.0.0.1:6379"
QUEUE_CONCURRENCY="4"
RATE_LIMIT_PROBE_PER_HOUR="10"
RATE_LIMIT_DOWNLOAD_PER_HOUR="5"
RATE_LIMIT_LOGIN_PER_HOUR="20"
YTDLP_TIMEOUT_MS="1800000"
YTDLP_PATH="/usr/local/bin/yt-dlp"
# Parallel DASH/HLS fragments (1–16). Higher = faster download on good CPU/network.
YTDLP_CONCURRENT_FRAGMENTS="4"
# ffmpeg copy when merging separate video+audio (set false to force re-encode)
YTDLP_FFMPEG_COPY_MERGE="true"

# Anti-bot (YouTube / TikTok / Instagram) — see docs/YTDLP_ANTI_BOT.md
# Netscape cookies.txt exported while logged in (Get cookies.txt LOCALLY extension)
# YTDLP_COOKIES_FILE="/var/lib/yaytd/cookies/cookies.txt"
YTDLP_JS_RUNTIMES="deno,node"
YTDLP_REMOTE_COMPONENTS="ejs:github"
YTDLP_DEFAULT_YOUTUBE_CLIENTS="true"
# YTDLP_EXTRACTOR_ARGS="youtube:player_client=android_vr,web_safari;tiktok:api_hostname=api22-normal-c-useast1a.tiktokv.com"
# YTDLP_YOUTUBE_PO_TOKEN=""
# YTDLP_SLEEP_REQUESTS="1"

# Install.sh sets a random admin password in .install-secrets
ADMIN_DEFAULT_PASSWORD="admin"
