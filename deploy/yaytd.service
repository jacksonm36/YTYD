[Unit]
Description=Yet Another YouTube Downloader (YAYTD) — web application
Documentation=file:///opt/yaytd/README.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=yaytd
Group=yaytd
WorkingDirectory=/opt/yaytd
EnvironmentFile=/opt/yaytd/.env
Environment=NODE_ENV=production
Environment=PORT=3001
# Loopback-only Next; nginx listens on :3000 and proxies here (see deploy/nginx-yaytd.conf).

ExecStart=/usr/bin/npm run start:prod

Restart=on-failure
RestartSec=10
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yaytd /opt/yaytd

[Install]
WantedBy=multi-user.target
