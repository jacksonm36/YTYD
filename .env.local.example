# Copy to .env.local for local development (overrides .env; gitignored).
# Or run: sudo YAYTD_APP_DIR=$PWD YAYTD_DEV_INSTALL=1 ./scripts/install.sh -y

NODE_ENV=development
TEMP_DOWNLOAD_DIR=/tmp/yaytd-downloads
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUST_PROXY=false
